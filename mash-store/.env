# =============================================================================
# MASH STORE ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env.local' and fill in real values for local testing.
# Add real secret values in Vercel or GitHub Secrets for production.
# =============================================================================

# Database Connection (PostgreSQL / Neon / Supabase)
DATABASE_URL="your_db_url"

# Admin Portal Password
ADMIN_PASSWORD="your_admin_password_here"
ADMIN_SECRET_SALT="your_admin_secret_salt_here"

# Google OAuth Credentials (Google Cloud Console)
GOOGLE_CLIENT_ID="your_google_client_id.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="your_google_client_secret_here"

# Admin Session Cookie configuration
ADMIN_SESSION_COOKIE_NAME="your_admin_session_cookie_name_here"
ADMIN_COOKIE_SECURE="your_cookie_secure_flag_here"
ADMIN_COOKIE_HTTP_ONLY="your_cookie_http_only_flag_here"
ADMIN_COOKIE_SAME_SITE="your_cookie_same_site_flag_here"
ADMIN_COOKIE_PATH="your_cookie_path_flag_here"
ADMIN_COOKIE_MAX_AGE="your_cookie_max_age_flag_here"